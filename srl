  <script>
    const toggleBtn = document.getElementById('mobileToggle');
    const navList = document.getElementById('navList');
    toggleBtn.addEventListener('click', () => {
      navList.classList.toggle('show');
    });

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const targetId = this.getAttribute('href');
        if (targetId === "#" || targetId === "") return;
        const targetElem = document.querySelector(targetId);
        if (targetElem) {
          e.preventDefault();
          targetElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (navList.classList.contains('show')) navList.classList.remove('show');
        }
      });
    });

    const form = document.getElementById('contactForm');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('fullName').value.trim();
        const phone = document.getElementById('contactNo').value.trim();
        if (!name || !phone) {
          alert("Please provide your name and phone number for quick response.");
          return;
        }
        alert(`Thank you ${name}! We will contact you shortly on ${phone}. For urgent requirements, call us directly at 6361045266 or email soudagarazar72@gmail.com`);
        form.reset();
      });
    }
  </script>
